{
	"extends": ["//"],
	"tasks": {
		"copy:wasm": {
			"dependsOn": ["@playground/wasm#build"],
			"inputs": [
				"../../packages/wasm/dist/ballerina.wasm",
				"../../packages/wasm/dist/ballerina-meta.json"
			],
			"outputs": ["public/ballerina.wasm", "public/ballerina-meta.json"]
		},
		"copy:compiler-wasm": {
			"inputs": [
				"../../packages/compiler/**/*.go",
				"../../packages/compiler/go.mod",
				"../../packages/compiler/go.sum",
				"!../../packages/compiler/**/*_test.go"
			],
			"outputs": ["public/compiler/**"]
		},
		"copy:ls-wasm": {
			"dependsOn": ["@playground/ls-wasm#build"],
			"inputs": [
				"../../packages/ls-wasm/dist/ballerina-ls.wasm",
				"../../packages/ls-wasm/dist/wasm_exec.js"
			],
			"outputs": ["public/ballerina-ls.wasm", "public/ls-wasm_exec.js"]
		},
		"build": {
			"env": ["COMMIT_SHA"],
			"dependsOn": [
				"^build",
				"copy:wasm",
				"copy:compiler-wasm",
				"copy:ls-wasm"
			],
			"outputs": ["dist/**"]
		},
		"dev": {
			"env": ["COMMIT_SHA"],
			"dependsOn": ["copy:wasm", "copy:compiler-wasm", "copy:ls-wasm"],
			"cache": false,
			"persistent": true
		},
		"preview": {
			"env": ["COMMIT_SHA"],
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build", "copy:wasm", "copy:compiler-wasm"],
			"cache": false
		}
	}
}
