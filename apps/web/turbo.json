{
	"extends": ["//"],
	"tasks": {
		"copy:wasm": {
			"dependsOn": ["@playground/wasm#build"],
			"inputs": [
				"../../packages/wasm/dist/ballerina.wasm",
				"../../packages/wasm/dist/ballerina-meta.json"
			],
			"outputs": ["public/ballerina.wasm", "public/ballerina-meta.json"]
		},
		"copy:compiler-wasm": {
			"inputs": [
				"../../packages/compiler/**/*.go",
				"../../packages/compiler/go.mod",
				"../../packages/compiler/go.sum",
				"!../../packages/compiler/**/*_test.go"
			],
			"outputs": ["public/compiler/**"]
		},
		"build": {
			"env": ["COMMIT_SHA"],
			"dependsOn": ["^build", "copy:wasm", "copy:compiler-wasm"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"env": ["COMMIT_SHA"],
			"dependsOn": ["copy:wasm", "copy:compiler-wasm"],
			"cache": false,
			"persistent": true
		},
		"preview": {
			"env": ["COMMIT_SHA"],
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build", "copy:wasm", "copy:compiler-wasm"],
			"cache": false
		}
	}
}
