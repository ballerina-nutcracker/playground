{
	"$schema": "https://turbo.build/schema.json",
	"globalEnv": ["UPDATE_EXAMPLE_OUTPUTS"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"test": {
			"cache": false
		},
		"clean": {
			"cache": false
		}
	}
}
