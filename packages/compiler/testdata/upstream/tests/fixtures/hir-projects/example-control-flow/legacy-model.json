          "end": {
            "line": 25,
            "column": 2
          }
        }
      },
      "text": "function process(int[] values) returns int {\n    int total = 0;\n    int index = 0;\n    while index \u003c 3 {\n        index += 1;\n        if index == 2 { continue; }\n        foreach int value in values {\n            if value == 1 { continue; }\n            if value \u003e 3 { break; }\n            total += value;\n        }\n        if total \u003e 20 { break; }\n    }\n    if total \u003c 0 {\n        return 0;\n    } else if total == 0 {\n        total = 1;\n    } else {\n        total += 2;\n    }\n    if total \u003e 10 {} else { total += 1; }\n    return total;\n}",
      "moduleId": "examples/control_flow",
