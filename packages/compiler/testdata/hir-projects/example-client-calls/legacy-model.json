          },
          "text": "resource function get hello() returns string|error {\n        Person person = check testClient-\u003eget(\"/foo/bar\");\n        return string `hello ${person.first_name} ${person.last_name}`;\n    }",
          "kind": "resource",
          "title": "get /hello",
          "functionId": "examples/client_calls/service/main.bal///1/resource/get/hello"
        }
      ],
