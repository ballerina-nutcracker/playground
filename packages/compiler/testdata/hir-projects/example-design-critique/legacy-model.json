      },
      "text": "service /orders on new http:Listener(8080) {\n    resource function post orders() returns int {\n        int[] items = [1, 2, 3];\n        int total = 0;\n        foreach int item in items {\n            if item \u003c minimum { continue; }\n            total += calculate(item);\n        }\n        if total \u003e 10 { total += 2; } else { total += 1; }\n        return total;\n    }\n    resource function get status() returns string { return \"ready\"; }\n}",
      "kind": "service",
      "title": "/orders",
      "moduleId": "examples/design_critique",
      "serviceType": "ballerina/http:Listener",
